cc_prebuilt_library_shared {
    name: "vendor.mediatek.hardware.nvram@1.0_mx",
    stem: "vendor.mediatek.hardware.nvram@1.0",
    target: { android_arm64: { srcs: ["lib64/vendor.mediatek.hardware.nvram@1.0.so"] } },
    compile_multilib: "64",
    vendor: true,
    check_elf_files: false,
    strip: { none: true },
}

dex_import {
    name: "mediatek-ims-base-cit",
    jars: ["framework/mediatek-ims-base.jar"],
    system_ext_specific: true,
}

dex_import {
    name: "mediatek-telephony-base-cit",
    jars: ["framework/mediatek-telephony-base.jar"],
    system_ext_specific: true,
}

prebuilt_etc {
    name: "cit-mtk-libs.xml",
