type factory_services, domain;
type factory_services_exec, exec_type, vendor_file_type, file_type;
type factory_interface_hwservice, hwservice_manager_type;

init_daemon_domain(factory_services)
hwbinder_use(factory_services)
add_hwservice(factory_services, factory_interface_hwservice)
get_prop(factory_services, hwservicemanager_prop)
allow factory_services fwk_sensor_hwservice:hwservice_manager find;
binder_call(factory_services, system_server)
allow factory_services self:capability { chown fowner };
r_dir_file(factory_services, sysfs_batteryinfo)
r_dir_file(factory_services, proc_cpuinfo)
allow factory_services proc_meminfo:file r_file_perms;

# Xiaomi CIT talks to the factory HAL
